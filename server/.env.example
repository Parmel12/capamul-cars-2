# ── Facebook / Meta Messenger ────────────────────────────
# FB_PAGE_ACCESS_TOKEN:
#   Get from: Facebook Developer Console → Your App → Messenger → Settings
#   → Generate Token (select your Page)
#   This is the token you paste here so the bot can reply to customers.
FB_PAGE_ACCESS_TOKEN="YOUR_FACEBOOK_PAGE_ACCESS_TOKEN_HERE"

# FB_VERIFY_TOKEN:
#   This is a secret string YOU choose. Enter the same value in:
#   Facebook Developer Console → Webhooks → Edit → Verify Token field.
#   Default value below is fine to keep as-is.
FB_VERIFY_TOKEN="capamul_cars_messenger_verify_token_123"
